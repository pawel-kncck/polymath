# Copy to `.env` for local development. Never commit secrets.
# In production, these are set in the Coolify dashboard.

# PostgreSQL connection string
# Use a separate local database; never use the production shared PostgreSQL URL.
# See README.md local setup and docs/INFRASTRUCTURE.md for production boundaries.
# Docker test runs need a reachable LOCAL database (e.g. host.docker.internal).
DATABASE_URL=""

# Auth.js v5 — full URL of the deployed app (no trailing slash)
AUTH_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Admin account bootstrapped by `npm run db:seed` (dev + first prod deploy)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
